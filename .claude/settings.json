{
  "enabledPlugins": {
    "caveman@caveman": true,
    "token-optimizer@alexgreensh-token-optimizer": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/active-claims.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking active claims"
          }
        ]
      }
    ]
  }
}
